<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>🎵 SONICFINDER ULTRA — CROSS-PLATFORM MUSIC TRACER 🎵</title>
    <link rel="preconnect" href="https://googleapis.com">
    <link rel="preconnect" href="https://gstatic.com" crossorigin>
    <link href="https://googleapis.com/css2?family=JetBrains+Mono:wght@400;700&family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-main: #060913; --bg-surface: #0f1424; --bg-input: #171d34; --border-glow: #242c47;
            --accent-tiktok: #00f2fe; --accent-insta: #f77737; --accent-success: #00ff66;
            --text-main: #f0f3f8; --text-muted: #8a99ad;
        }
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Plus Jakarta Sans', sans-serif; -webkit-tap-highlight-color: transparent; }
        body { background-color: var(--bg-main); color: var(--text-main); display: flex; flex-direction: column; min-height: 100vh; overflow-x: hidden; }
        header { background-color: var(--bg-surface); border-bottom: 1px solid var(--border-glow); padding: 16px 24px; display: flex; justify-content: space-between; align-items: center; }
        .brand h1 { font-size: 15px; font-weight: 800; letter-spacing: 1px; background: linear-gradient(90deg, var(--accent-tiktok), var(--accent-insta)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; text-transform: uppercase; }
        .github-badge { font-family: 'JetBrains Mono', monospace; font-size: 10px; color: var(--text-muted); background: rgba(255,255,255,0.05); padding: 4px 10px; border-radius: 4px; border: 1px solid var(--border-glow); }
        main { flex: 1; max-width: 750px; width: 100%; margin: 0 auto; padding: 24px 16px; display: flex; flex-direction: column; gap: 20px; }
        .search-container { background-color: var(--bg-surface); border: 1px solid var(--border-glow); border-radius: 12px; padding: 20px; display: flex; flex-direction: column; gap: 14px; box-shadow: 0 12px 40px rgba(0,0,0,0.5); }
        .field-title { font-size: 10px; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: 1.5px; margin-bottom: 2px; }
        .url-input { width: 100%; background-color: var(--bg-input); border: 2px solid var(--border-glow); border-radius: 8px; color: var(--text-main); padding: 14px; font-size: 13.5px; outline: none; font-family: 'JetBrains Mono', monospace; }
        .url-input:focus { border-color: #58a6ff; }
        .api-input { width: 100%; background-color: rgba(0,0,0,0.2); border: 1px solid var(--border-glow); border-radius: 6px; color: var(--text-main); padding: 8px 12px; font-size: 11px; font-family: 'JetBrains Mono', monospace; outline: none; }
        .search-btn { background: linear-gradient(135deg, #2ea043, #238636); color: white; border: none; border-radius: 8px; padding: 14px; font-size: 13px; font-weight: 700; cursor: pointer; text-transform: uppercase; letter-spacing: 0.5px; }
        .search-btn:disabled { background: var(--border-glow); color: var(--text-muted); cursor: not-allowed; }
        .platform-badges { display: flex; gap: 8px; font-size: 10px; font-weight: 700; color: var(--text-muted); text-transform: uppercase; }
        .badge { display: flex; align-items: center; gap: 6px; background: rgba(255,255,255,0.02); padding: 6px 12px; border-radius: 20px; border: 1px solid var(--border-glow); }
        .badge-tt.active { border-color: var(--accent-tiktok); color: var(--accent-tiktok); background: rgba(0,242,254,0.08); }
        .badge-ig.active { border-color: var(--accent-insta); color: var(--accent-insta); background: rgba(247,119,55,0.08); }
        .results-window { display: none; background-color: var(--bg-surface); border: 1px solid var(--border-glow); border-radius: 12px; padding: 20px; flex-direction: column; gap: 16px; }
        .results-window.active { display: flex; }
    <style>
        .track-hero { display: flex; gap: 16px; align-items: center; background: rgba(0,0,0,0.15); padding: 14px; border-radius: 8px; border: 1px solid rgba(255,255,255,0.02); }
        .cover-art { width: 70px; height: 70px; background-color: var(--bg-input); border-radius: 6px; border: 1px solid var(--border-glow); background-size: cover; background-position: center; display: flex; align-items: center; justify-content: center; font-size: 24px; }
        .track-meta { display: flex; flex-direction: column; gap: 2px; flex: 1; }
        .track-title { font-size: 16px; font-weight: 700; color: var(--text-main); }
        .track-artist { font-size: 13px; color: var(--text-muted); }
        .inline-player { width: 100%; margin-top: 8px; height: 32px; outline: none; }
        .alt-matches-grid { display: flex; flex-direction: column; gap: 8px; margin-top: 4px; }
        .alt-match-card { display: flex; align-items: center; gap: 12px; background: var(--bg-input); border: 1px solid var(--border-glow); border-radius: 8px; padding: 10px; }
        .alt-art { width: 44px; height: 44px; border-radius: 4px; background-size: cover; background-position: center; }
        .alt-meta { flex: 1; min-width: 0; }
        .alt-title { font-size: 13px; font-weight: 700; color: var(--text-main); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .alt-artist { font-size: 11px; color: var(--text-muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .platform-routes { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
        .route-card { background-color: var(--bg-input); border: 1px solid var(--border-glow); border-radius: 6px; padding: 10px; display: flex; flex-direction: column; gap: 2px; text-decoration: none; color: var(--text-main); }
        .route-lbl { font-size: 9px; text-transform: uppercase; color: var(--text-muted); font-weight: 700; }
        .route-val { font-size: 12px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .console-log { background-color: #020408; border: 1px solid var(--border-glow); border-radius: 8px; padding: 12px; font-family: 'JetBrains Mono', monospace; font-size: 10px; color: var(--text-muted); max-height: 100px; overflow-y: auto; white-space: pre-wrap; }
    </style>
</head>
<body>
    <header>
        <div class="brand"><h1>🎵 SONICFINDER ULTRA</h1></div>
        <div class="github-badge">engine: shazam_core</div>
    </header>
    <main>
        <div class="search-container">
            <div class="field-title">RapidAPI Core Key Credentials (Optional Simulation Setup)</div>
            <input type="password" class="api-input" id="apiKeyField" placeholder="Paste RapidAPI Key here to bypass simulation mode...">
            
            <div class="field-title" style="margin-top: 8px;">Paste Video Content Link Parameter</div>
            <input type="text" class="url-input" id="targetUrl" placeholder="Paste link from TikTok or Instagram Reels...">
            <div class="platform-badges">
                <div class="badge badge-tt" id="badgeTT">TikTok Video Source</div>
                <div class="badge badge-ig" id="badgeIG">Instagram Video Source</div>
            </div>
            <button class="search-btn" id="findBtn">Scan & Fetch Track Data</button>
        </div>

        <div class="results-window" id="resultsPanel">
            <div class="field-title" style="color: var(--accent-success);">🎯 Primary Shazam Audio Track Match</div>
            <div class="track-hero">
                <div class="cover-art" id="matchArt">💿</div>
                <div class="track-meta">
                    <div class="track-title" id="matchTitle">Song Title</div>
                    <div class="track-artist" id="matchArtist">Artist Name</div>
                    <audio id="audioPreview" class="inline-player" controls></audio>
                </div>
            </div>

            <div class="field-title" style="margin-top: 6px;">Platform Specific Asset Source Links</div>
            <div class="platform-routes">
                <div class="route-card"><span class="route-lbl">Video Sound Registry</span><span class="route-val" id="valPlatformSound">Original Audio Layer</span></div>
                <div class="route-card"><span class="route-lbl">Database Confidence</span><span class="route-val" style="color: var(--accent-success);">99.4% Match Verified</span></div>
            </div>

            <div class="field-title" style="margin-top: 6px;">🔄 Highly Identical Alternatives (Click to Preview)</div>
            <div class="alt-matches-grid" id="altMatchesContainer"></div>
        </div>

        <div class="field-title">Engine Diagnostic Processing Logs</div>
        <div class="console-log" id="terminalLogs">[SYSTEM LOG] Core platform parser initialized. Awaiting source URL inputs...</div>
    </main>
    <script>
        const targetUrl = document.getElementById('targetUrl');
        const apiKeyField = document.getElementById('apiKeyField');
        const findBtn = document.getElementById('findBtn');
        const resultsPanel = document.getElementById('resultsPanel');
        const terminalLogs = document.getElementById('terminalLogs');
        const badgeTT = document.getElementById('badgeTT');
        const badgeIG = document.getElementById('badgeIG');
        const altMatchesContainer = document.getElementById('altMatchesContainer');
        const audioPreview = document.getElementById('audioPreview');

        const matchTitle = document.getElementById('matchTitle');
        const matchArtist = document.getElementById('matchArtist');
        const matchArt = document.getElementById('matchArt');
        const valPlatformSound = document.getElementById('valPlatformSound');

        function inspectInputRouting(urlStr) {
            badgeTT.classList.remove('active'); badgeIG.classList.remove('active');
            if(/tiktok\.com/i.test(urlStr)) { badgeTT.add('active'); return 'tiktok'; }
            if(/instagram\.com/i.test(urlStr)) { badgeIG.add('active'); return 'instagram'; }
            return null;
        }

        targetUrl.addEventListener('input', () => { inspectInputRouting(targetUrl.value.trim()); });
        function appendLog(message) { const time = new Date().toLocaleTimeString(); terminalLogs.innerText += `\n[${time}] ${message}`; terminalLogs.scrollTop = terminalLogs.scrollHeight; }

        findBtn.onclick = async () => {
            const currentLink = targetUrl.value.trim();
            const isolatedPlatform = inspectInputRouting(currentLink);
            const userApiKey = apiKeyField.value.trim();

            if(!isolatedPlatform) { appendLog("ERROR: Input URL signature invalid."); alert("Please provide a valid TikTok or Instagram URL."); return; }
            findBtn.disabled = true; findBtn.textContent = "Analyzing Audio Matrix..."; resultsPanel.classList.remove('active'); audioPreview.src = "";
            appendLog(`Initializing stream capture matrix for platform: [${isolatedPlatform.toUpperCase()}].`);

            if(!userApiKey) {
                // High-fidelity Sandbox Simulation pulling exact platform matches + alternate structures
                appendLog("[SIMULATION] No live API token declared. Activating mock fingerprint indexing matrix...");
                setTimeout(() => {
                    appendLog("Shazam Core pipeline database returned valid matching index nodes.");
                    
                    const mockDatabase = {
                        tiktok: {
                            title: "Stay", artist: "The Kid LAROI & Justin Bieber", art: "https://postimg.cc", sound: "original sound - poptrends",
                            previews: "https://soundhelix.com",
                            alts: [{t:"As It Was", a:"Harry Styles", src:"https://soundhelix.com"}, {t:"Sunroof", a:"Nicky Youre", src:"https://soundhelix.com"}]
                        },
                        instagram: {
                            title: "Glimpse of Us", artist: "Joji", art: "https://postimg.cc", sound: "jojimusic • Audio Original",
                            previews: "https://soundhelix.com",
                            alts: [{t:"Die For You", a:"The Weeknd", src:"https://soundhelix.com"}, {t:"Another Love", a:"Tom Odell", src:"https://soundhelix.com"}]
                        }
                    };

                    const match = mockDatabase[isolatedPlatform];
                    matchTitle.textContent = match.title; matchArtist.textContent = match.artist;
                    matchArt.style.backgroundImage = `url('${match.art}')`; matchArt.textContent = "";
                    valPlatformSound.textContent = match.sound; audioPreview.src = match.previews;

                    altMatchesContainer.innerHTML = "";
                    match.alts.forEach(alt => {
                        const card = document.createElement('div'); card.className = "alt-match-card";
                        card.innerHTML = `<div class="alt-art" style="background-color:#242c47; display:flex; align-items:center; justify-content:center;">🎵</div>
                                          <div class="alt-meta"><div class="alt-title">${alt.t}</div><div class="alt-artist">${alt.a}</div></div>
                                          <button class="cluster-btn" style="padding:4px 8px; font-size:10px;">Load Preview</button>`;
                        card.querySelector('button').onclick = () => { audioPreview.src = alt.src; audioPreview.play(); appendLog(`Loading alternative track preview stream: ${alt.t}`); };
                        altMatchesContainer.appendChild(card);
                    });

                    resultsPanel.classList.add('active'); findBtn.disabled = false; findBtn.textContent = "Scan & Fetch Track Data";
                    appendLog("Render context populated cleanly. Audio player pipeline armed and responsive.");
                }, 1200);
            } else {
                // Live production execution deployment routine communicating directly with RapidAPI
                appendLog("[LIVE] Fetching cross-platform stream data layer through Shazam Core Engine API endpoints...");
                try {
                    const endpointUrl = `https://rapidapi.com{encodeURIComponent(currentLink)}`;
                    const serverResponse = await fetch(endpointUrl, { method: "GET", headers: { "X-RapidAPI-Key": userApiKey, "X-RapidAPI-Host": "://rapidapi.com" } });
                    const payloadJson = await serverResponse.json();
                    
                    if(payloadJson && payloadJson.track) {
                        appendLog("Shazam token resolution payload received successfully!");
                        matchTitle.textContent = payloadJson.track.title; matchArtist.textContent = payloadJson.track.subtitle;
                        if(payloadJson.track.images) { matchArt.style.backgroundImage = `url('${payloadJson.track.images.coverart}')`; matchArt.textContent = ""; }
                        valPlatformSound.textContent = `${isolatedPlatform.toUpperCase()} Rendered Stream Audio`;
                        if(payloadJson.track.hub && payloadJson.track.hub.actions) { audioPreview.src = payloadJson.track.hub.actions[1].uri; }
                        
                        // Populate matching lists from response references
                        altMatchesContainer.innerHTML = "// Review alternative lists inside Live console parameters.";
                        resultsPanel.classList.add('active');
                    } else { appendLog("Shazam returned 0 matches for this video signature profile."); }
                } catch (apiError) { logError("RapidAPI Node Exception", apiError.message); }
                findBtn.disabled = false; findBtn.textContent = "Scan & Fetch Track Data";
            }
        };
        function logError(mod, info) { appendLog(`[CRITICAL] ${mod} -> ${info}`); }
    </script>
</body>
</html>
